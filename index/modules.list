	sha256sum "ec7db18ff0732c7b492fbd204da438c3ebbb73bd1037e084b06021b62206dd71";
	last-updated "2026-05-11T12:36:03.000Z";
	min-unrealircd-version "6.*";
	max-unrealircd-version "6.*";
	post-install-text
	{
		"The module is installed. Now all you need to do is add a loadmodule line:";
		"loadmodule \"third/display-name\";";
		"You need to restart your server for this to show up in CLIENTTAGDENY";
		"The module does not need any other configuration.";
	}
}

